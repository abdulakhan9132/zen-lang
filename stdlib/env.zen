// ZEN Environment & CLI arguments standard library module
fn argv() -> list {
    return _zenstd_rt.env_argv()
}

fn get(name: string, default_val: any = none) -> any {
    return _zenstd_rt.env_get(name, default_val)
}

fn set(name: string, val: string) {
    _zenstd_rt.env_set(name, val)
}

fn has(name: string) -> bool {
    return _zenstd_rt.env_has(name)
}

fn all() -> map {
    return _zenstd_rt.env_all()
}

fn platform() -> string {
    return _zenstd_rt.env_platform()
}

fn os_name() -> string {
    return _zenstd_rt.env_os_name()
}
