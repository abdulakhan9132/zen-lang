// Stage 3 self-tests: standard library modules and doctests
import json
import path
import regex
import csv
import stats
import env

let data = json.parse("{\"nums\": [2, 4, 4, 4, 5, 5, 7, 9]}")
assert stats.mean(data["nums"]) == 5.0
assert stats.median(data["nums"]) == 4.5
assert abs(stats.std(data["nums"]) - 2.0) < 1e-9

let rows = csv.parse("name,val\nzen,3\n")
assert rows[1][0] == "zen" and rows[1][1] == "3"
assert regex.replace("[0-9]+", "N", "v0.3.0") == "vN.N.N"
assert path.join(["docs", "guide_examples"]) == "docs/guide_examples"
assert len(env.platform()) > 0

//> say 1 + 1
// 2
//> import stats
//> say stats.mean([10, 20, 30])
// 20.0

say "Stage 3 stdlib self-tests passed"
