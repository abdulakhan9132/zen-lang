import zennum as zn
import zennet as nn

zn.seed(42)
let text = read_file("examples/tiny.txt")
let tok = nn.CharTokenizer(text)
let ids = tok.encode(text)
let cfg = {
    "vocab_size": tok.vocab_size,
    "n_layer": 1,
    "n_head": 2,
    "d_model": 8,
    "block_size": 6
}
let model = nn.GPT(cfg)
let opt = nn.Adam(model.parameters(), 0.06)

for step in range(40) {
    let batch = nn.text_to_batches(ids, 6, 2)
    let loss = nn.cross_entropy(model(batch[0]), batch[1])
    opt.zero_grad()
    loss.backward()
    opt.step()
    if step == 0 or step == 39 {
        say "step " + str(step) + " | loss = " + str(round(loss.item(), 4))
    }
}

model.save("docs/guide_examples/guide_checkpoint.json")
let reloaded = nn.GPT(cfg)
reloaded.load("docs/guide_examples/guide_checkpoint.json")
let out = nn.generate(reloaded, tok.encode("zen "), 24, 0.8, 4)
say "sample: " + tok.decode(out)
