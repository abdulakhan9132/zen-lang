import zennum as zn

zn.seed(42)

let a = zn.arange(1, 13).reshape([3, 4])
say "Array a:"
say a
say "Shape: " + str(a.shape) + ", ndim: " + str(a.ndim) + ", size: " + str(a.size)

say "Slice a[1:3, 1:3]:"
say a[1:3, 1:3]

let pos = a[a > 6]
say "Values > 6:"
say pos

let b = zn.ones([1, 4]) * 10
say "Broadcast a + b:"
say a + b

say "Row sums: " + str(zn.sum(a, 1))
say "Mean: " + str(zn.mean(a))
say "Matmul (2x3 @ 3x2):"
let m1 = zn.array([[1, 2, 3], [4, 5, 6]])
let m2 = zn.eye(3, 2)
say m1 @ m2
